{
  "name": "pi-blackhole",
  "version": "0.4.4",
  "packageManager": "pnpm@11.2.2",
  "description": "Unified compaction + observational memory extension for Pi — compresses conversation context while preserving durable observations and reflections",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "*.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!tests/",
    "tsup.config.ts",
    "LICENSE",
    "README.md",
    "example-config.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint",
    "prepare": "node scripts/prepare.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "pi-agent",
    "pi-blackhole",
    "blackhole",
    "compact",
    "compaction",
    "observational-memory",
    "recall",
    "ai",
    "agents",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0valik/pi-blackhole.git"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-ai": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.81.1 <1.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "tsup": "^8.5.1",
    "lint-staged": "15.5.2",
    "prettier": "3.9.6",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
